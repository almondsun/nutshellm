# Copy these names into your deployment environment manager. Never commit real values.
ENVIRONMENT=development
DATABASE_PATH=data/nutshellm.sqlite3
RESULT_TTL_SECONDS=3600
PARITOK_API_KEY=replace-at-runtime
PARITOK_BASE_URL=https://www.paritok.com/api
PARITOK_MODEL=paritok-4b-v1
TASK_MODEL_API_KEY=replace-at-runtime
TASK_MODEL_BASE_URL=https://api.openai.com/v1
TASK_MODEL=gpt-4.1-mini
TASK_MAX_OUTPUT_TOKENS=1200
TASK_REASONING_EFFORT=
TASK_MODEL_MAX_RETRIES=1
TASK_MODEL_RETRY_MAX_DELAY_SECONDS=35
JUDGE_MODEL=
ENABLE_LLM_JUDGE=false
TASK_INPUT_USD_PER_MTOK=0
TASK_OUTPUT_USD_PER_MTOK=0
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAMES=your-production.example
SESSION_SIGNING_SECRET=replace-with-a-random-value
PER_IP_DAILY_RUN_LIMIT=5
GLOBAL_DAILY_RUN_LIMIT=100
GLOBAL_DAILY_BUDGET_USD=10
MAX_TASK_CHARS=4000
MAX_SEGMENTS=12
MAX_CONTEXT_CHARS=50000
TRUSTED_PROXY_CIDRS=
